  "narrative": {
    "northStar": "The Working Studio",
    "overview": "Pixbe should feel like a thoughtfully arranged place to get work done: warm paper, crisp ink, quiet structure, and a small number of purposeful color accents. The interface is professional without feeling sterile, confident without being loud.",
    "keyCharacteristics": [
      "Warm ivory canvas and white working surfaces, with deep navy typography.",
      "Clear editorial hierarchy: an assertive task heading, concise supporting copy, then direct controls.",
      "Restrained blue interaction states and sage confirmation; semantic red only for errors.",
      "Custom, consistent line illustrations for meaningful choices; utility icons only where they speed scanning.",
      "Explicit state and validation: a selection, save, invitation, or launch must never look complete before it is."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "A screen may have semantic states, but only one color should read as its primary interaction accent. Avoid rainbow navigation, multi-colored cards, and decorative gradients.",
        "section": "colors"
      },
      {
        "name": "The Legibility Rule",
        "body": "Never put muted blue-gray text on a dark fill. On dark surfaces use near-white text with tested contrast; never communicate state by color alone.",
        "section": "colors"
      },
      {
        "name": "The Answer-First Rule",
        "body": "Titles state the task, not an abstract module name. Supporting text explains consequences in one or two sentences.",
        "section": "typography"
      },
      {
        "name": "The Density Follows Work Rule",
        "body": "A first-run decision can breathe; an all-day operations table should prioritize scanability. Carry identity through type, color, borders, and rhythm—not identical padding everywhere.",
        "section": "layout"
      },
      {
        "name": "The Almost-Flat Rule",
        "body": "No deep blur, glow, or heavy elevation as general decoration. Meaningful state and surface contrast do the work.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the setup flow as the visual reference, adapting density to the task.",
      "Do use real content states, clear validation, and accurate save and launch language.",
      "Do pair warm paper, clean white surfaces, deep ink, measured blue, and quiet sage.",
      "Do test desktop and phone layouts, keyboard use, focus, and contrast.",
      "Do give company and institute workflows equal care while preserving their distinct terminology."
    ],
    "donts": [
      "Don't seed a new workspace with fake offices, people, departments, or roles.",
      "Don't decorate with a wall of generic Lucide icons, gradients, glow, oversized shadows, or multi-colored cards.",
      "Don't mark a step complete or show a save confirmation before data is persisted.",
      "Don't transpose the onboarding layout wholesale onto a dense dashboard or table.",
      "Don't claim the existing global stylesheet or dark theme already matches this guide; migrate and test them deliberately."
    ]
  }
}
