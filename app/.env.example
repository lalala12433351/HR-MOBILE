# Server Environment
NODE_ENV=development
PORT=8080
# Production: list both frontend hosts. Local: * is fine.
ALLOWED_ORIGINS=https://app.pixbe.in,https://masteradmin.pixbe.in
APP_ORIGIN=https://app.pixbe.in
MASTER_ADMIN_ORIGIN=https://masteradmin.pixbe.in
# Base URL used for links inside emails (invite, password reset)
FRONTEND_APP_ORIGIN=https://app.pixbe.in
# Secret for app-signed tokens (email verification, platform admin sessions)
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL Database Configuration (Standard AWS RDS PostgreSQL db.t4g.micro or Local Postgres)
# Format: postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require&connection_limit=10
DATABASE_URL=postgresql://postgresadmin:YOUR_RDS_PASSWORD@enterprise-bos-rds.c1234567890.us-east-1.rds.amazonaws.com:5432/enterprise_bos?sslmode=require&connection_limit=10

# Discrete connection parameters (used if DATABASE_URL is not set)
DB_HOST=enterprise-bos-rds.c1234567890.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=enterprise_bos
DB_USER=postgresadmin
DB_PASSWORD=YOUR_RDS_PASSWORD
DB_SSL=true
# Conservative max connection pool (5-10) tailored for db.t4g.micro (~85 max connection ceiling)
DB_MAX_CONNECTIONS=10

# AWS Cognito Configuration
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_CLIENT_ID=exampleclientid12345
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# AWS S3 Storage (KMS Encrypted)
S3_BUCKET_NAME=enterprise-bos-documents-us-east-1
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Transactional email via Amazon SES (same region as AWS_REGION)
# "ses" sends real email; "log" prints emails + links to the console (local dev)
EMAIL_TRANSPORT=ses
SES_FROM_EMAIL=Pixbe <auth@pixbe.in>
SES_REPLY_TO=
SES_CONFIGURATION_SET=
EMAIL_BRAND_NAME=Pixbe
SUPPORT_EMAIL=support@pixbe.in
